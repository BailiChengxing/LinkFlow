{
  "manifest_version": 3,
  "name": "清链助手",
  "version": "1.0.4",
  "description": "批量提取与清洗文本中的 URL，极简、高效、无广告。",
  "browser_specific_settings": {
    "gecko": {
      "id": "bailichengxing@gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "ico16.png",
    "32": "ico32.png",
    "48": "ico48.png",
    "64": "ico64.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "清链助手",
    "default_icon": "icon.png"
  },
  "permissions": [
    "clipboardRead"
  ]
}